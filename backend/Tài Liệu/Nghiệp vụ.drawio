        <mxCell id="tWJX5LWkZjOSj8c28ctt-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;p data-path-to-node=&quot;5,0,0&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;b data-path-to-node=&quot;5,0,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Kiểm tra tư cách (Pre-validation):&lt;/b&gt; Khi học viên mở Form đánh giá, hệ thống kiểm tra:&lt;/font&gt;&lt;/p&gt;&lt;ul data-path-to-node=&quot;5,0,1&quot;&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,1,0,0&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;code data-path-to-node=&quot;5,0,1,0,0&quot; data-index-in-node=&quot;0&quot;&gt;StudentId&lt;/code&gt; có trong bảng &lt;code data-path-to-node=&quot;5,0,1,0,0&quot; data-index-in-node=&quot;24&quot;&gt;Enrollments&lt;/code&gt; không?&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,1,1,0&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;code data-path-to-node=&quot;5,0,1,1,0&quot; data-index-in-node=&quot;0&quot;&gt;LearningProgress&lt;/code&gt; của học viên này cho khóa học đó có &lt;span class=&quot;math-inline&quot; data-math=&quot;\ge 10\%&quot; data-index-in-node=&quot;53&quot;&gt;&lt;span class=&quot;katex&quot;&gt;&lt;span class=&quot;katex-html&quot; aria-hidden=&quot;true&quot;&gt;&lt;span class=&quot;base&quot;&gt;&lt;span class=&quot;strut&quot; style=&quot;height: 0.7719em; vertical-align: -0.136em;&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mrel&quot;&gt;≥&lt;/span&gt;&lt;span class=&quot;mspace&quot; style=&quot;margin-right: 0.2778em;&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span class=&quot;base&quot;&gt;&lt;span class=&quot;strut&quot; style=&quot;height: 0.8056em; vertical-align: -0.0556em;&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mord&quot;&gt;10%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; không?&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p data-path-to-node=&quot;5,0,1,2,0&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;i data-path-to-node=&quot;5,0,1,2,0&quot; data-index-in-node=&quot;0&quot; style=&quot;&quot;&gt;Kết quả:&lt;/i&gt; Nếu không thỏa mãn, nút &quot;Gửi&quot; sẽ bị vô hiệu hóa kèm thông báo giải thích.&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="140" width="360" x="425" y="340" as="geometry" />
        </mxCell>
        <mxCell id="tWJX5LWkZjOSj8c28ctt-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;b data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;0&quot;&gt;Gửi dữ liệu (Submission):&lt;/b&gt; Học viên chọn số sao (1-5) và viết bình luận &lt;span class=&quot;math-inline&quot; data-math=&quot;\rightarrow&quot; data-index-in-node=&quot;79&quot;&gt;&lt;span class=&quot;strut&quot; style=&quot;height: 0.3669em;&quot;&gt;&lt;/span&gt;&lt;span class=&quot;mrel&quot;&gt;→&lt;/span&gt;&lt;/span&gt; Backend nhận &lt;code data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;104&quot;&gt;RatingValue&lt;/code&gt; và &lt;code data-path-to-node=&quot;5,1,0&quot; data-index-in-node=&quot;119&quot;&gt;Comment&lt;/code&gt;." vertex="1">
          <mxGeometry height="60" width="260" x="890" y="390" as="geometry" />
        </mxCell>
        <mxCell id="tWJX5LWkZjOSj8c28ctt-12" edge="1" parent="1" source="tWJX5LWkZjOSj8c28ctt-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="tWJX5LWkZjOSj8c28ctt-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tWJX5LWkZjOSj8c28ctt-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&#xa;&lt;b data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;0&quot;&gt;Cập nhật bảng đích (Denormalization):&lt;/b&gt; Điểm trung bình và tổng lượt đánh giá được ghi đè (Overwrite) vào bảng &lt;code data-path-to-node=&quot;5,3,0&quot; data-index-in-node=&quot;117&quot;&gt;Courses&lt;/code&gt;.&#xa;&#xa;" vertex="1">
          <mxGeometry height="70" width="230" x="1250" y="390" as="geometry" />
        </mxCell>
        <mxCell id="tWJX5LWkZjOSj8c28ctt-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&#xa;&lt;b data-path-to-node=&quot;5,4,0&quot; data-index-in-node=&quot;0&quot;&gt;Phản hồi UI:&lt;/b&gt; Frontend hiển thị thông báo thành công và cập nhật lại dãy sao trung bình ngoài trang giới thiệu khóa học.&#xa;&#xa;" vertex="1">
